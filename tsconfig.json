{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false, // 🔹 desative se não houver JS puro
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "useDefineForClassFields": true, // 🔹 padrão moderno
    "verbatimModuleSyntax": true, // 🔹 melhora tree-shaking
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true, // 🔹 pega erros de acesso a índices
    "noImplicitOverride": true, // 🔹 exige `override` em heranças
    "noUnusedLocals": true, // 🔹 detecta variáveis não usadas
    "noUnusedParameters": true, // 🔹 detecta parâmetros não usados
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "next.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
