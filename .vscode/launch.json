{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: attach (container)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/./*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack:///../*": "${workspaceFolder}/../*",
        "webpack:///*": "*",
        "meteor://💻app/*": "${workspaceFolder}/*"
      },
      "autoAttachChildProcesses": false
    },
    {
      "name": "Next.js: launch local",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "${workspaceFolder}/node_modules/next/dist/bin/next",
        "dev",
        "--hostname", "localhost",
        "--port", "3000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/./*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
        "webpack:///../*": "${workspaceFolder}/../*",
        "webpack:///*": "*",
        "meteor://💻app/*": "${workspaceFolder}/*"
      },
      "autoAttachChildProcesses": true,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Chrome: local (3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Chrome: container (3001)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/./*": "${workspaceFolder}/*"
      }
    }
  ]
}