    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@scalar/api-reference-react": "^0.8.36",
    "@scalar/themes": "^0.18.0",
    "@sentry/nextjs": "^10.75.0",
    "ajv": "^8.20.0",
    "azure-devops-node-api": "^15.1.2",
    "chart.js": "^4.4.0",
    "date-fns": "^4.4.0",
    "exceljs": "^3.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "rasterizehtml": "^1.4.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
