{
  "name": "debit-board",
  "description": "[db] Debit-Board API",
  "version": "2026.9.30",
  "private": true,
  "type": "module",
  "scripts": {
    "disable-telemetry": "npx next telemetry disable",
    "dev": "next dev --turbopack",
    "dev:https": "npx next dev --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost-cert.pem",
    "build": "next build && cp .env.production.local .next/standalone/.env && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "node --env-file=.next/standalone/.env .next/standalone/server.js",
    "prod": "yarn run build && yarn run start",
    "lint": "npx eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "npx vitest run --coverage --reporter=junit,html --outputFile=./coverage/test-report.junit.xml && open coverage/index.html",
    "dev:docker": "node --inspect=0.0.0.0:9229 ./node_modules/.bin/next dev --hostname 0.0.0.0 --port 3001"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
